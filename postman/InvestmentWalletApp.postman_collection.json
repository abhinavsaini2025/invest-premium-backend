{
  "info": {
    "_postman_id": "1ebec179-1ccc-486d-ac04-6366f5c2cbfa",
    "name": "Investment Wallet App API",
    "description": "Full API collection for the Investment & Wallet Management backend.\n\nSetup:\n1. Import this collection AND the \"Investment Wallet App - Local\" environment.\n2. Run `npm run seed` on the backend first.\n3. Run \"Auth > Login (demo user)\" - it auto-saves accessToken/refreshToken to the environment.\n4. Every other request already uses {{accessToken}} - just run them.\n\nRegistration is instant and returns tokens. Password recovery uses the security question returned by \"Auth > Forgot Password\".",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates the user and returns access/refresh tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Aditi Sharma\",\n  \"mobile\": \"{{mobile}}\",\n  \"password\": \"{{password}}\",\n  \"securityQuestion\": \"What city were you born in?\",\n  \"securityAnswer\": \"mumbai\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login (demo user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Works immediately after `npm run seed` (demo user is pre-verified). Auto-saves tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{mobile}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  const data = json.data || {};",
                  "  if (data.accessToken) pm.environment.set('accessToken', data.accessToken);",
                  "  if (data.refreshToken) pm.environment.set('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
